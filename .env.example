# Copy to .env (never committed) or set these in the Vercel project settings.
# Every value below is a safe local default or an empty placeholder.

# Leave empty locally to use backend/seatplan.db (SQLite).
# Production: the Postgres URL from your provider (postgres://... is accepted).
DATABASE_URL=

# Signs login sessions. REQUIRED whenever DATABASE_URL is Postgres, and at
# least 32 characters long (the app refuses to start otherwise, demo mode or
# not). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty with SQLite, a random key is made per process (fine on a laptop only).
SECRET_KEY=

# The only browser origin allowed to call the API (CORS).
FRONTEND_ORIGIN=http://localhost:5173
# Base URL used to build links inside emails.
PUBLIC_BASE_URL=http://localhost:5173

# 1 turns on /api/demo/* (the demo links and the reset).
DEMO_MODE=1
# Shared secret for POST /api/demo/reset (header X-Demo-Key). The only way to
# reset: empty means nobody can.
DEMO_KEY=
# Demo account passwords. Only on local SQLite with DEMO_MODE=1 may they stay
# empty (the public defaults in backend/app/seed/run.py are then used). On
# Postgres they are required: choose private values and share them only with
# the people who need them.
DEMO_ORGANISER_PASSWORD=
DEMO_STAFF_PASSWORD=

# Header X-Cron-Secret for POST /api/internal/email/process.
CRON_SECRET=

# console prints emails to the log; resend sends real email.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=SeatPlan <noreply@example.com>
# Comma-separated addresses that may receive real email. Everything else is
# stored with status "skipped".
EMAIL_ALLOWLIST=
